# Data: the store, blobs, clones, models, heartbeats, logs and reports of every data directory (data/, data-dev/,
# any `--data-dir data-*` at the root). Nothing harvested or generated is committed, except the yardstick's human labels.
/data*/

# Reports at the root: the Markdown write-ups are committed; any large machine output beside them is not.
/reports/*
!/reports/*.md

# Portable dataset bundles (`honed bundle export`): published as release assets, never committed.
*.jsonl.gz
*.jsonl.zst
*.report.json

# Environments and caches.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Editors and the OS.
*.swp
.DS_Store
.idea/
.vscode/
